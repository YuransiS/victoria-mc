{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "victoria-visualcontent.vercel.app"
        }
      ],
      "destination": "https://victoria-mc.vercel.app/free-lection/vsl-form",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/vsl-report",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/vsl-report?type=weekly",
      "schedule": "0 7 * * 1"
    }
  ]
}
